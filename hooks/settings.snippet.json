{
  "_comment": "Drop these into your Claude Code .claude/settings.json 'hooks' section. Replace <ABS> with the absolute path to this repo. On Windows use python; on macOS/Linux you may prefer python3. Verify the exact hook-config shape against your Claude Code version's docs.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python \"<ABS>/reference-impl/hooks/session_start_inject.py\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python \"<ABS>/reference-impl/hooks/user_prompt_submit_inject.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python \"<ABS>/reference-impl/hooks/post_tool_use_capture.py\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python \"<ABS>/reference-impl/hooks/stop_distill.py\"" }
        ]
      }
    ]
  }
}
